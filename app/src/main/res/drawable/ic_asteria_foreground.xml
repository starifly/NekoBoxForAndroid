    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Orbital Ring -->
    <path
        android:pathData="M 54 22 C 71.67 22 86 36.33 86 54 C 86 71.67 71.67 86 54 86 C 36.33 86 22 71.67 22 54 C 22 36.33 36.33 22 54 22 Z"
        android:strokeWidth="1.8"
        android:strokeAlpha="0.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86">
                <item android:color="#FF818CF8" android:offset="0.0" />
                <item android:color="#FFC084FC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Celestial Core / 8-Point Asteria Star -->
    <path
        android:pathData="M 54 27 L 57.5 45.5 L 75 42 L 61 54 L 75 66 L 57.5 62.5 L 54 81 L 50.5 62.5 L 33 66 L 47 54 L 33 42 L 50.5 45.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="27"
                android:endX="75"
                android:endY="81">
                <item android:color="#FF67E8F9" android:offset="0.0" />
                <item android:color="#FF818CF8" android:offset="0.5" />
                <item android:color="#FFE879F9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Radiant Diamond -->
    <path
        android:pathData="M 54 46 L 62 54 L 54 62 L 46 54 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Orbital Energy Sparks -->
    <path
        android:pathData="M 54 18 L 55.5 21 L 54 24 L 52.5 21 Z"
        android:fillColor="#FF67E8F9" />
    <path
        android:pathData="M 90 54 L 87 55.5 L 84 54 L 87 52.5 Z"
        android:fillColor="#FFC084FC" />
    <path
        android:pathData="M 54 90 L 52.5 87 L 54 84 L 55.5 87 Z"
        android:fillColor="#FFE879F9" />
    <path
        android:pathData="M 18 54 L 21 52.5 L 24 54 L 21 55.5 Z"
        android:fillColor="#FF818CF8" />

</vector>
